  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login / Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-saves the token + userId into collection variables so every",
                  "// other request in this collection is authenticated automatically.",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const token = body.token || body.accessToken || (body.data && body.data.token);",
                  "  const user = body.user || body.data;",
                  "  if (token) pm.collectionVariables.set('token', token);",
                  "  if (user && user.id) pm.collectionVariables.set('userId', user.id);",
                  "  console.log('Saved token/userId:', token, user && user.id);",
                  "} else {",
                  "  console.warn('Login did not return 2xx — check response shape manually.');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+8801712345678\",\n  \"name\": \"Rafi Changed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "No separate signup — new phone auto-registers, existing phone logs in. Response includes a JWT."
          },
          "response": []
        },
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns the user tied to the bearer token. Useful for restoring a session on reload."
          },
          "response": []
        }
      ]
    },
